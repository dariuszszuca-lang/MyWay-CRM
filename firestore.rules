rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dostep do danych pacjentow ma WYLACZNIE zespol MyWay.
    // Wczesniej wystarczylo byc zalogowanym czymkolwiek: kazde konto Google, ktore
    // zalogowalo sie do tego projektu, mialo pelny odczyt i zapis kart pacjentow
    // (PESEL, adres, dane o leczeniu, finanse). Lista dozwolonych adresow zyla tylko
    // w kodzie strony (services/accessControl.ts), wiec byla zabezpieczeniem pozornym.
    //
    // 🔴 Ta lista MUSI byc zgodna z ALLOWED_EMAILS w services/accessControl.ts.
    // Dodajesz kogos do zespolu? Zmien w OBU miejscach, inaczej interfejs go wpusci,
    // a baza odmowi (albo odwrotnie).
    function zespolMyWay() {
      return [
        'dariusz.szuca@gmail.com',
        'krystiannagaba@gmail.com',
        'mywaymarcin@gmail.com',
        'npucz708@gmail.com',
        'gabinet.osrodekmyway@gmail.com',
        'beatakorzonek1@gmail.com',
        'waldemarsikorski77@gmail.com',
        'stanislaw.babinski@gmail.com',
        'patrycjabjerk88@gmail.com',
        'kuskowskam@gmail.com'
      ];
    }

    function czlonekZespolu() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in zespolMyWay();
    }

    match /patients/{patientId} {
      allow read, write: if czlonekZespolu();
    }
    match /queue/{queueId} {
      allow read, write: if czlonekZespolu();
    }
    match /rooms/{roomId} {
      allow read, write: if czlonekZespolu();
    }
    match /roomAssignments/{assignmentId} {
      allow read, write: if czlonekZespolu();
    }

    // Phone module. Financial amounts and report archives have a narrower audience.
    function phoneStats() {
      return czlonekZespolu() && request.auth.token.email.lower() in [
        'dariusz.szuca@gmail.com', 'mywaymarcin@gmail.com', 'npucz708@gmail.com', 'krystiannagaba@gmail.com'
      ];
    }
    function shortText(s) { return s is string && s.size() <= 120; }
    function phoneDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function phoneTime(s) { return s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function phoneContactValid(d) {
      return d.keys().hasOnly(['label','phone','firstDate','firstTime','category','quality','temperature','source','stage','province','status','closedDate','lossReason','nextDate','nextTime','followupStatus','note','followupNote','owner','revision','historical','historicalCount','historicalDuration','historicalFirstTime','historicalClosedAt','historicalFollowupAt','historicalExtraNotes','followupConfirmed','updatedBy','updatedAt','createdBy','createdAt'])
        && shortText(d.label) && d.label.size() > 0 && shortText(d.phone)
        && phoneDate(d.firstDate) && (d.firstTime == '' || phoneTime(d.firstTime))
        && shortText(d.category) && d.quality in ['', 'A', 'B', 'C', 'D']
        && shortText(d.temperature) && shortText(d.source) && shortText(d.province)
        && d.stage in ['Nowy', 'W kontakcie', 'Wygrany', 'Przegrany']
        && shortText(d.status) && shortText(d.lossReason) && shortText(d.owner)
        && (d.closedDate == '' || (phoneDate(d.closedDate) && d.closedDate >= d.firstDate))
        && (d.stage != 'Wygrany' || d.closedDate != '' || d.get('historical', false))
        && (d.nextDate == '' || phoneDate(d.nextDate))
        && (d.nextTime == '' || (d.nextDate != '' && phoneTime(d.nextTime)))
        && shortText(d.followupStatus)
        && d.note is string && d.note.size() <= 4000
        && d.followupNote is string && d.followupNote.size() <= 4000
        && d.get('historical', false) is bool && d.get('followupConfirmed', false) is bool
        && shortText(d.get('historicalFirstTime', '')) && shortText(d.get('historicalClosedAt', '')) && shortText(d.get('historicalFollowupAt', ''))
        && d.get('historicalExtraNotes', '') is string && d.get('historicalExtraNotes', '').size() <= 4000
        && shortText(d.get('historicalCount', '')) && shortText(d.get('historicalDuration', ''))
        && d.revision is int && d.revision > 0
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function phoneHasAudit(id, revision) {
      let audit = getAfter(/databases/$(database)/documents/phoneAudit/$(id + '_' + string(revision))).data;
      return audit.contactId == id && audit.revision == revision
        && audit.createdBy == request.auth.uid && audit.createdAt == request.time;
    }
    match /phoneContacts/{id} {
      allow read: if czlonekZespolu();
      allow create: if czlonekZespolu() && phoneContactValid(request.resource.data)
        && !request.resource.data.get('historical', false)
        && request.resource.data.revision == 1
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && phoneHasAudit(id, 1);
      allow update: if czlonekZespolu() && phoneContactValid(request.resource.data)
        && request.resource.data.get('historical', false) == resource.data.get('historical', false)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && phoneHasAudit(id, request.resource.data.revision);
      allow delete: if false;
    }
    match /phoneCalls/{id} {
      allow read: if czlonekZespolu();
      allow create: if czlonekZespolu()
        && request.resource.data.keys().hasOnly(['contactId','date','time','kind','durationSeconds','result','answered','fullConversation','callback','note','createdBy','createdAt'])
        && request.resource.data.contactId is string
        && phoneDate(request.resource.data.date) && phoneTime(request.resource.data.time)
        && request.resource.data.kind in ['Pierwszy kontakt','Kolejna rozmowa']
        && (request.resource.data.durationSeconds == null || (request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 36000))
        && request.resource.data.result in ['Umówiony krok','Rezerwacja','Zadatek','Brak decyzji','Nieodebrany','Poza ofertą','Rezygnacja']
        && request.resource.data.answered is bool && request.resource.data.fullConversation is bool && request.resource.data.callback is bool
        && (request.resource.data.result != 'Nieodebrany' || !request.resource.data.answered)
        && (!request.resource.data.fullConversation || request.resource.data.answered)
        && request.resource.data.note is string && request.resource.data.note.size() <= 4000
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/phoneContacts/$(request.resource.data.contactId)).data.updatedAt == request.time
        && request.resource.data.date >= getAfter(/databases/$(database)/documents/phoneContacts/$(request.resource.data.contactId)).data.firstDate;
      allow update, delete: if false;
    }
    match /phoneAudit/{id} {
      allow read: if czlonekZespolu();
      allow create: if czlonekZespolu()
        && request.resource.data.keys().hasOnly(['contactId','revision','action','before','after','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.action in ['Rozmowa','Edycja kontaktu']
        && request.resource.data.after is map
        && (request.resource.data.before == null || request.resource.data.before is map)
        && getAfter(/databases/$(database)/documents/phoneContacts/$(request.resource.data.contactId)).data.revision == request.resource.data.revision
        && id == request.resource.data.contactId + '_' + string(request.resource.data.revision);
      allow update, delete: if false;
    }
    match /phoneFinancials/{id} {
      allow read: if phoneStats();
      allow create, update: if phoneStats()
        && request.resource.data.keys().hasOnly(['amount','updatedBy','updatedAt'])
        && (request.resource.data.amount == null || (request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 10000000))
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/phoneContacts/$(id)).data.updatedAt == request.time;
      allow delete: if false;
    }
    match /phoneFinancialAudit/{id} {
      allow read: if phoneStats();
      allow create: if phoneStats()
        && request.resource.data.keys().hasOnly(['contactId','revision','before','after','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/phoneContacts/$(request.resource.data.contactId)).data.revision == request.resource.data.revision
        && id == request.resource.data.contactId + '_' + string(request.resource.data.revision);
      allow update, delete: if false;
    }
    match /phoneReports/{id} {
      allow read: if phoneStats();
      allow create: if phoneStats() && request.resource.data.keys().hasOnly(['kind','from','to','summary','filters','generatedAt','automatic','createdBy','createdAt'])
        && request.resource.data.kind in ['day','week','month','year','custom']
        && phoneDate(request.resource.data.from) && phoneDate(request.resource.data.to) && request.resource.data.from <= request.resource.data.to
        && request.resource.data.summary is map && request.resource.data.filters is map
        && request.resource.data.generatedAt is string && request.resource.data.automatic == false
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /phoneImportSources/{id} {
      allow read: if phoneStats();
      allow write: if false;
    }
    match /phoneImportRuns/{id} {
      allow read: if phoneStats();
      allow write: if false;
    }
    match /phoneReportState/{id} {
      allow read: if phoneStats();
      allow write: if false;
    }
  }
}
